{
	"name": "n8n-nodes-virkly",
	"version": "0.1.0",
	"description": "n8n community node for virkly: Danish company data (CVR) lookups",
	"license": "MIT",
	"homepage": "https://virkly.io",
	"keywords": [
		"n8n-community-node-package",
		"cvr",
		"denmark",
		"company-data"
	],
	"author": {
		"name": "virkly",
		"email": "support@virkly.io"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/virkly/n8n-nodes-virkly.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "node --test test/*.test.js",
		"scan": "node scripts/scan.mjs",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo",
		"!dist/**/*.map",
		"!dist/**/*.d.ts"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/VirklyApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Virkly/Virkly.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.56.4",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
